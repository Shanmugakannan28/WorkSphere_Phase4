# Copy to .env (auto-created with a random SECRET_KEY on first run)
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_MINUTES=480
GRACE_MINUTES=10
EARLY_WINDOW_MINUTES=30
LEAVE_CONFLICT_LIMIT=2
MAX_UPLOAD_MB=5
ADMIN_EMAIL=admin@worksphere.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Your Name
# Optional email integration (leave SMTP_HOST empty to log emails to storage/outbox.log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=WorkSphere <no-reply@yourcompany.com>
SMTP_TLS=1
